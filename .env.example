# ==========================================================================
# Zopfaktion: Umgebung auf dem Server (prod und dev/staging)
# Kopieren nach .env im Projektordner auf dem Server und ausfüllen.
# Die ausgefüllte .env NIE committen. Lokal: .env.dev.example.
# ==========================================================================

# --- Adresse -----------------------------------------------------------------
# Domain dieser Installation. Web und API laufen beide darunter (API unter /api).
# Ein Domainwechsel braucht nur diese Zeile und `docker compose up -d`.
APP_DOMAIN=zopf.example.ch

# Traefik: Name des Zertifikats-Resolvers und des Proxy-Netzes dieser Installation.
TRAEFIK_CERTRESOLVER=myresolver
# prod: zopf_prod_proxy, dev: zopf_dev_proxy (vorher: docker network create <name>)
PROXY_NETWORK=zopf_prod_proxy

# --- Datenbank -------------------------------------------------------------
DB_USER=zopf
DB_PASSWORD=STARKES_ZUFALLSPASSWORT   # openssl rand -hex 24
DB_NAME=zopf

# --- Sicherheit --------------------------------------------------------------
# Signiert Sitzungen und Links. Mind. 32 Zeichen: openssl rand -hex 32
JWT_SECRET=MIND_32_ZEICHEN_ZUFALL
# Optional: Passwort des ersten Admins (Konto "admin"), sonst steht eines einmal im Log.
INITIAL_ADMIN_PASSWORD=

# --- Branding (leer = Cevi-Standard) ------------------------------------------
ORG_NAME=Cevi
APP_NAME=Zopfaktion
# Hex-Farben, z. B. #003d8f (Cevi-Blau) und #e20031 (Cevi-Rot)
BRAND_COLOR_PRIMARY=
BRAND_COLOR_SECONDARY=
# Eigenes Logo: Ordner ./branding neben docker-compose.yml mit logo.svg und/oder logo.png
# (PNG für PDFs, SVG für die Webseite) und optional favicon.ico. Fehlt eine Datei, gilt der Standard.

# --- Kontakt und Rechtliches ---------------------------------------------------
CONTACT_EMAIL=
LEGAL_IMPRINT_URL=
# Postadresse des Vereins (Datenschutzerklärung, Fuss von Rundmails), z. B. "Musterstrasse 1, 8000 Zürich"
LEGAL_POSTAL_ADDRESS=

# --- Zahlung ---------------------------------------------------------------------
# Konto für die QR-Rechnung. Fehlt etwas davon, ist die QR-Rechnung ausgeschaltet.
PAYMENT_IBAN=
PAYMENT_CREDITOR_NAME=
PAYMENT_CREDITOR_ADDRESS=
PAYMENT_CREDITOR_ZIP=
PAYMENT_CREDITOR_CITY=
# Text vor der Bestellnummer in der Mitteilung, z. B. "Zopfaktion"
PAYMENT_MESSAGE=
# Inhalt des statischen TWINT-QR-Codes (Routenblatt, Lieferansicht). Leer = kein TWINT-QR.
TWINT_QR_PAYLOAD=

# --- Mail (wie Cevi-Laden) -------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# z. B. "Zopfaktion <zopf@example.ch>"
SMTP_FROM=
# Auf dev setzen ("DEV"): Betreff bekommt [DEV], Mails tragen einen Hinweis.
MAIL_ENV_LABEL=
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

# --- Optional ---------------------------------------------------------------------
# Quelle des Adressverzeichnisses (Standard: swisstopo, amtliches Gebaeudeadressverzeichnis als CSV-ZIP).
# Nur aendern fuer einen eigenen Spiegel.
ADDRESS_DIRECTORY_URL=
# Routing mit Strassennetz (eigener OSRM-Server). Leer = Luftlinie.
OSRM_URL=
# Personendaten von Bestellungen werden so viele Monate nach dem Liefertag anonymisiert.
PERSONAL_DATA_RETENTION_MONTHS=24
# Stunden, bis eine unbestätigte Bestellung verfällt.
ORDER_CONFIRM_HOURS=48
# debug, info, warn, error
LOG_LEVEL=info
