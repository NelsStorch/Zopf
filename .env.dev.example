# ==========================================================================
# Zopfaktion: lokale Entwicklung
#   cp .env.dev.example .env
#   docker compose -f docker-compose.dev.yml up --build
# Web: http://localhost:3000, API: http://localhost:3000/api (über Next.js weitergeleitet)
# ==========================================================================

# Lokale Ports (ändern, wenn schon belegt; DATABASE_URL unten dann mitändern)
PORT_WEB=3000
PORT_API=4000
PORT_DB=5432

DB_USER=zopf_dev
DB_PASSWORD=dev_password_local_only
DB_NAME=zopf_dev
# Für Prisma-Befehle ausserhalb von Docker (npm run db:migrate)
DATABASE_URL=postgresql://zopf_dev:dev_password_local_only@localhost:5432/zopf_dev?schema=public

JWT_SECRET=dev_jwt_secret_only_for_local_development_1234567890
INITIAL_ADMIN_PASSWORD=admin-dev-passwort

# Branding (leer = Cevi-Standard)
ORG_NAME=
APP_NAME=
BRAND_COLOR_PRIMARY=
BRAND_COLOR_SECONDARY=

CONTACT_EMAIL=
LEGAL_IMPRINT_URL=
LEGAL_POSTAL_ADDRESS=

# Zahlung: zum Testen eine Beispiel-IBAN aus der SIX-Dokumentation verwenden
PAYMENT_IBAN=
PAYMENT_CREDITOR_NAME=
PAYMENT_CREDITOR_ADDRESS=
PAYMENT_CREDITOR_ZIP=
PAYMENT_CREDITOR_CITY=
PAYMENT_MESSAGE=
TWINT_QR_PAYLOAD=

# Mail: leer = Mails werden nur ins Log geschrieben
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_ENV_LABEL=LOCAL

LOG_LEVEL=debug
